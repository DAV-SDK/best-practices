#!/usr/bin/env bash
# Fake `gh` CLI used by tests. Instead of talking to GitHub, `gh repo clone`
# copies a canned repo tree from $GH_FAKE_FIXTURES into the destination dir,
# based on the shape of the `gh repo clone <repo> <dir> -- <git flags>` calls
# made by bin/check-repo.sh.
set -euo pipefail

fixtures_root="${GH_FAKE_FIXTURES:?GH_FAKE_FIXTURES must be set}"

[[ "${1:-}" == "repo" && "${2:-}" == "clone" ]] || { echo "fake gh: unsupported command: $*" >&2; exit 1; }
shift 2

repo="${1:?fake gh: missing repo}"
dest="${2:?fake gh: missing destination}"
shift 2
[[ "${1:-}" == "--" ]] && shift

branch=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch) branch="$2"; shift 2 ;;
    *) shift ;;
  esac
done

repo_dir="${fixtures_root}/${repo//\//__}"
if [[ -n "$branch" ]]; then
  src="${repo_dir}/branches/${branch}"
else
  src="${repo_dir}/branches/default"
fi
[[ -d "$src" ]] || { echo "fake gh: no fixture branch at ${src}" >&2; exit 1; }

mkdir -p "$dest"
cp -a "${src}/." "$dest/"

# Fake a git checkout of the resolved branch so `git rev-parse
# --abbrev-ref HEAD` in check-repo.sh reports something sensible.
git -C "$dest" init --quiet --initial-branch="${branch:-main}"
git -C "$dest" add -A
git -c user.email=test@example.com -c user.name=test -C "$dest" commit --quiet -m fixture
