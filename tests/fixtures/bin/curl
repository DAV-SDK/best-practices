#!/usr/bin/env bash
# Fake `curl` used by tests, for the CDash existence check in
# checks.d/10-cdash-dashboard.sh and the Repology lookup in
# checks.d/60-spack-latest-release.sh.
set -euo pipefail

url=""
has_w=false
for arg in "$@"; do
  case "$arg" in
    http*) url="$arg" ;;
    -w) has_w=true ;;
  esac
done
[[ -n "$url" ]] || { echo "fake curl: no URL in: $*" >&2; exit 1; }

host="${url#*://}"
host="${host%%/*}"

if [[ "$has_w" == true ]]; then
  # -o ... -w '%{http_code}' style call: only the CDash existence check
  # uses this. Looks up "<host> <project>" against a fixture list of
  # known-existing host/project pairs and prints "200" or "404" - whatever
  # the real invocation's -w would have captured.
  fixtures_file="${CURL_FAKE_CDASH_PROJECTS:?CURL_FAKE_CDASH_PROJECTS must be set}"
  project="${url#*project=}"
  project="${project%%&*}"
  if grep -qxF "${host} ${project}" "$fixtures_file"; then
    printf '200'
  else
    printf '404'
  fi
  exit 0
fi

# Plain body-fetch call: only the Repology lookup uses this. Prints the
# fixture JSON for the requested project, or "[]" (Repology's shape for an
# unknown project) if there's no fixture for it.
project="${url##*/}"
fixture_file="${CURL_FAKE_REPOLOGY_DIR:-}/${project}.json"
if [[ -n "${CURL_FAKE_REPOLOGY_DIR:-}" && -f "$fixture_file" ]]; then
  cat "$fixture_file"
else
  printf '[]'
fi
